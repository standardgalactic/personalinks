\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Ejecución de una secuencia de operadores sobre la pila de una MPS. El estado inicial contiene el espacio $X_0$. Tras \emph  {pop} se obtiene $X_1 \subsetneq X_0$. \emph  {bind} introduce un segundo espacio $Y$ en la pila. $\mathrm  {bind}_C$ combina ambos en $Z_C = \mathrm  {bind}_C(X_1, Y)$. \emph  {collapse} produce la pila final con el cociente $Z_C / {\sim }$.}}{23}{figure.caption.10}\protected@file@percent }
\newlabel{fig:pila_ejecucion}{{9}{23}{Ejecución de una secuencia de operadores sobre la pila de una MPS. El estado inicial contiene el espacio $X_0$. Tras \emph {pop} se obtiene $X_1 \subsetneq X_0$. \emph {bind} introduce un segundo espacio $Y$ en la pila. $\mathrm {bind}_C$ combina ambos en $Z_C = \mathrm {bind}_C(X_1, Y)$. \emph {collapse} produce la pila final con el cociente $Z_C / {\sim }$}{figure.caption.10}{}}
